<?xml version="1.0" encoding="utf-8"?>
<!--
  S10 spike: prove an AccessibilityService can deliver Back / Recents to third-party apps.

  canPerformGestures is not needed - we only use performGlobalAction().
  We request TYPE_WINDOW_STATE_CHANGED so the service can also report the current
  foreground package, which Stride needs for media ownership tracking (plan section 3.2).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description"/>
