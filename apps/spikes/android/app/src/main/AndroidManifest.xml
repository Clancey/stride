<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S3: overlay windows over other apps. Grant with:
         adb shell appops set io.stride.spikes SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- S9: keep the coordinator/overlay service alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- API 34+ requires a typed foreground service. The overlay is neither media nor location nor
         any of the other predefined categories - it draws diagnostic/navigation windows for a
         console with no hardware buttons - so "special use" is the honest type. Harmless below 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- S2: GlassOS gRPC is on loopback, but INTERNET is still required for sockets -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Lets Stride put its own accessibility and notification-listener grants back after Android
         drops them. Reinstalling the app clears enabled_accessibility_services, which silently
         kills Back and Recents on a console that has no physical buttons - the rider is then stuck
         inside whatever app is on screen with no way out and nothing on screen explaining why.

         This is a development-tier permission: it can never be granted by a dialog, only once over
         adb, and it then survives reinstalls because the app keeps declaring it:
             adb shell pm grant io.stride.spikes android.permission.WRITE_SECURE_SETTINGS

         Without the grant Stride simply falls back to asking the rider, so this is an upgrade to
         the recovery path rather than a requirement. Stride writes exactly two keys with it and
         only ever adds its own component - see StridePermissions.repair. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions"/>

    <!-- App store: the update checker only runs when there is a network, and WorkManager needs to
         read that state to honour its NetworkType.CONNECTED constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- App store: install APKs through PackageInstaller. API 26 replaced the global "unknown
         sources" toggle with this per-app permission; the user still confirms every single install,
         so this grants the right to *ask*, not the right to install silently. Grant with:
         adb shell appops set io.stride.spikes REQUEST_INSTALL_PACKAGES allow -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Read the console's GSF device id, which is the value a rider must register at
         google.com/android/uncertified to use a sideloaded Play Store (docs/APPSTORE.md §11.5).
         Read-only access to one key/value provider; it grants nothing else. Without it the
         diagnostics screen can only tell a tester their id is unavailable, and the alternative
         ways to read it are a Play Store app (which is the broken thing) or root. -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"/>

    <!-- Direct machine access. Only used when the rider selects the DIRECT transport; the GlassOS
         path talks to a local socket and needs none of this.

         USB host needs no runtime permission to *enumerate*, but opening a device requires the
         per-device consent dialog, which UsbSerialTransport requests. The feature is declared
         required="false" so a console without a host-capable port still installs the app.

         Bluetooth is split by API level. BLUETOOTH/BLUETOOTH_ADMIN are the pre-31 install-time
         permissions and are capped there; BLUETOOTH_CONNECT is the API 31+ runtime replacement.
         neverForLocation is accurate and not a convenience: this scans for one known treadmill
         service UUID and has no business inferring where the rider is. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>

    <!-- S4 app enumeration under targetSdk 30+ package-visibility filtering.
         This <queries> block restores visibility of exactly the things the launcher legitimately
         resolves: MAIN/LAUNCHER + MAIN/LEANBACK_LAUNCHER (the app grid, incl. TV-only apps),
         MAIN/HOME (S1 home candidates / revert path), the MediaBrowserService signal (S5 ranking),
         and the iFit console package by name (S2 cert extraction).
         We deliberately do NOT request QUERY_ALL_PACKAGES: it is a Google Play policy-restricted
         permission and has no place in a shipping launcher. Ignored below targetSdk 30. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
        <!-- Removing a pinned app hands the package to the system uninstaller. Without this the
             ACTION_DELETE resolve fails under package-visibility filtering and the tile's Remove
             from console button would look broken rather than simply unavailable. -->
        <intent>
            <action android:name="android.intent.action.DELETE"/>
            <data android:scheme="package"/>
        </intent>
        <package android:name="com.ifit.rivendell"/>
        <!-- GSF owns the gservices provider holding the device id above. Package-visibility
             filtering hides content providers too, so without this the query returns null on a
             targetSdk 30+ build and the id looks absent on a console where Play is installed. -->
        <package android:name="com.google.android.gsf"/>
    </queries>

    <application
        android:label="Stride Spikes"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- S1: register as a HOME launcher candidate.
                 CRITICAL: read docs/RUNBOOK.md for the revert procedure BEFORE
                 setting this as the default launcher on the treadmill. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- S3 / S9: overlay host. foregroundServiceType is required at API 34+ (see permission
             note above); "specialUse" is the honest category for diagnostic/navigation overlay
             windows. The subtype property documents that use for review tooling. Both are ignored
             below API 34, so the targetSdk 28 build is unaffected. -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Diagnostic overlay and edge-navigation windows for a console with no hardware Home/Back buttons (Phase 0 spike harness). Never commands the motor."/>
        </service>

        <!-- S3: restart the draw-only overlay after reboot so "survives reboot" can be tested.
             SAFETY: this harness has no motor-control path, so nothing started on boot can move the
             belt (see BootReceiver). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- App store: fetches the catalog, downloads and verifies artifacts, and drives
             PackageInstaller. Foreground because the work must continue while the rider is inside
             Spotify and the Flutter engine is dead. "specialUse" for the same reason the overlay is:
             it is neither media nor location nor any other predefined category.
             SAFETY: this service has no motor path. It reads WorkoutSession state only, to avoid
             raising a full-screen install dialog over the stop control while the belt is moving. -->
        <service
            android:name="io.stride.spikes.appstore.StrideAppstoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Background app catalog and update installer for a sideload-only console with no app store. Never commands the motor."/>
        </service>

        <!-- App store: Stride is both the installer and the thing being installed, and updating a
             package kills every process it owns. On a phone that is harmless - the Home button
             starts the freshly updated launcher. This console has no Home button, and Stride's
             overlay *is* the Home button, so without this the rider is stranded in whatever app was
             behind Stride. The platform restarts the process to deliver MY_PACKAGE_REPLACED; this
             receiver uses that to put the launcher and its overlay back. -->
        <receiver
            android:name="io.stride.spikes.appstore.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Lets `adb` read the GSF device id for Google's uncertified-device registration. The
             shell cannot read it itself (no READ_GSERVICES) and the database behind it needs root,
             so asking the app is the only way to drive that registration from a computer.

             Exported, because a broadcast from the shell has to reach it - but gated on DUMP, which
             the shell user holds and an ordinary app does not. Without that gate this would publish
             a stable device identifier to every app on a console whose whole job is running other
             people's software. -->
        <receiver
            android:name="io.stride.spikes.CertificationDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.stride.spikes.DUMP_CERTIFICATION"/>
            </intent-filter>
        </receiver>

        <!-- App store: PackageInstaller session results, including the STATUS_PENDING_USER_ACTION
             confirmation intent, land at InstallResultReceiver - which is registered at RUNTIME by
             StrideAppstoreService, deliberately not here.

             This console's firmware drops background broadcasts to a manifest ("static") receiver
             of an O+ app:
               I/ActivityManager: App .../io.stride.spikes targets O+, restricted
               D/BroadcastQueue: suppress to start process of staticReceiver for package:...
               V/BroadcastQueue: Skipping delivery of ordered broadcast ...INSTALL_STATUS
             With the receiver declared here, every install hung at "installing" with no dialog and
             no error, because the status the installer sends back was never delivered. Declaring it
             again would also double-deliver to the runtime registration and raise two dialogs. -->

        <!-- S10: Back / Recents. The ONLY mechanism available to a non-system app.
             Enable with:
               adb shell settings put secure enabled_accessibility_services \
                 io.stride.spikes/io.stride.spikes.StrideAccessibilityService
               adb shell settings put secure accessibility_enabled 1 -->
        <service
            android:name=".StrideAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- S5: MediaSession access. Enable with:
             adb shell cmd notification allow_listener \
               io.stride.spikes/io.stride.spikes.StrideNotificationListener -->
        <service
            android:name=".StrideNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
